// Place your settings in this file to overwrite default and user settings.
{
  "files.exclude": {
    "out": true,
    "node_modules": true,
    ".vscode-test": true
  },
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "search.exclude": {
    "out": true
  }
}
